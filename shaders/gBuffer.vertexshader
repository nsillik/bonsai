
layout(location = VERTEX_POSITION_LAYOUT_LOCATION)    in vec3 vertexPosition_modelspace; // NOTE(Jesse): 8-bit
layout(location = VERTEX_NORMAL_LAYOUT_LOCATION)      in vec3 vertexNormal_modelspace;
layout(location = VERTEX_COLOR_LAYOUT_LOCATION)       in uint ColorIndex;
layout(location = VERTEX_TRANS_EMISS_LAYOUT_LOCATION) in ivec2 in_TransEmiss; // NOTE(Jesse): 8-bit

out vec3 vertexP_worldspace;
out vec3 vertexN_worldspace;
out vec3 MaterialColor;
out vec2 TransEmiss;

uniform vec3 MinClipP_worldspace;
uniform vec3 MaxClipP_worldspace;

uniform vec3 OffsetOfWorldCenterToGrid;
uniform vec3 CameraToWorld;

uniform mat4 ViewProjection;

uniform sampler2D ColorPalette;

struct transform_data
{
  mat4 ModelMatrix;
  mat4 NormalMatrix;
};

// NOTE(nsillik)(macos): This was a std430 shader storage buffer, which needs GLSL 4.30
// to spell and is absent from macOS' 4.1 core context.  A texture buffer is core since
// 3.1 and has no layout rules -- texel N is bytes [16N, 16N+16) -- so the struct can be
// reassembled from texels without changing its C++ counterpart at all.
//
// sizeof(render_matrix_pair) is 128 = 8 texels of GL_RGBA32F.
uniform samplerBuffer TransformBuffer;

// NOTE(nsillik)(macos): Replaces gl_DrawID, which is GLSL 4.60
// (GL_ARB_shader_draw_parameters) and likewise unavailable at 4.10.  render.cpp uploads
// it once per draw in the indirect loop that replaced glMultiDrawArraysIndirect.
uniform int DrawIndex;

#define TRANSFORM_TEXEL_COUNT 8

transform_data
LoadTransform(int Index)
{
  int Base = Index * TRANSFORM_TEXEL_COUNT;

  transform_data Result;
  Result.ModelMatrix  = mat4(texelFetch(TransformBuffer, Base + 0),
                             texelFetch(TransformBuffer, Base + 1),
                             texelFetch(TransformBuffer, Base + 2),
                             texelFetch(TransformBuffer, Base + 3));
  Result.NormalMatrix = mat4(texelFetch(TransformBuffer, Base + 4),
                             texelFetch(TransformBuffer, Base + 5),
                             texelFetch(TransformBuffer, Base + 6),
                             texelFetch(TransformBuffer, Base + 7));
  return Result;
}

// TODO(Jesse): Pass in a m3 here.  I didn't have an m3 struct, so I didn't
// bother, but I should do that at some point..

void main()
{
  /* uint Transparency = uint((vertexMaterial>>16) & 0xFFu); */
  /* uint Emission     = uint((vertexMaterial>>8)  & 0xFFu); */
  /* uint ColorIndex   = uint((vertexMaterial)     & 0xFFFFu); */
  int Transparency = in_TransEmiss.x;
  int Emission = in_TransEmiss.y;

  /* MaterialColor = texelFetch(ColorPalette, ivec2(ColorIndex, 0), 0).rgb; */
  MaterialColor = UnpackV3_655b(ColorIndex).grb;
  /* if (LengthSq(MaterialColor) > 0.f) { MaterialColor = V3(1,0,0); } */
  /* MaterialColor = texelFetch(ColorPalette, ivec2(5, 0), 0).rgb; */
  /* MaterialColor = V3(1,0,1); */
  TransEmiss = V2(float(Transparency)/255.f, float(Emission)/(255.f/RENDERER_MAX_LIGHT_EMISSION_VALUE));
  /* TransEmiss = V2(0.5f, 0.5f); */

#if 1
  transform_data Transform = LoadTransform(DrawIndex);
  mat4 ModelMatrix = Transform.ModelMatrix;
  mat4 NormalMatrix = Transform.NormalMatrix;
#else
  mat4 ModelMatrix = mat4(
      v4(1,0,0,0),
      v4(0,1,0,0),
      v4(0,0,1,0),
      v4(0,0,0,1)
      );

  mat4 NormalMatrix = mat4(
      v4(1,0,0,0),
      v4(0,1,0,0),
      v4(0,0,1,0),
      v4(0,0,0,1)
      );

#endif

  v4 WorldVertex = ModelMatrix*vec4(vertexPosition_modelspace, 1);

  vertexP_worldspace = WorldVertex.xyz;

  // NOTE(Jesse): We have to normalize because a scale factor in the NormalMatrix will grow/shrink the normal!
  // TODO(Jesse): Is there some way of avoiding this?  I guess hlhl
  vertexN_worldspace = normalize(mat3(NormalMatrix) * V3(vertexNormal_modelspace));

  gl_Position =  ViewProjection * WorldVertex;
}

